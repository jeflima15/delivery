# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGO_URI: String de conexão com o MongoDB (Atlas ou Local)
MONGO_URI="mongodb+srv://usuario:senha@cluster.mongodb.net/stitch?retryWrites=true&w=majority"

# JWT_SECRET: Chave secreta para assinatura dos tokens JWT
JWT_SECRET="sua_chave_secreta_super_segura_aqui"

# ADMIN_SECRET_TOKEN: Token estático para acesso ao painel administrativo
ADMIN_SECRET_TOKEN="admin_stitch_123"

# KEYS DO SUPABASE
VITE_SUPABASE_URL=https://xksevymyoeiqssdjktam.supabase.co
