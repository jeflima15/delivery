# Servidor
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
JWT_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-an-independent-random-secret
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DEFAULT_TENANT_SLUG=loja-piloto
DEFAULT_TENANT_OWNER_NAME=Proprietario
DEFAULT_TENANT_OWNER_EMAIL=owner@example.com
DEFAULT_TENANT_OWNER_PHONE=+5500000000000
DEFAULT_TENANT_TIMEZONE=America/Sao_Paulo
OTP_PROVIDER=disabled
OTP_LOCAL_WEBHOOK_URL=http://localhost:8787/otp
OTP_WEBHOOK_URL=https://notifications.example.com/otp
OTP_WEBHOOK_SECRET=replace-with-a-long-webhook-secret
ADMIN_INVITE_WEBHOOK_URL=http://localhost:8787/admin-invite
UPSTASH_REDIS_REST_URL=https://REGION.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-server-only-upstash-token

# Cookies (nomes, nao segredos)
SESSION_COOKIE_NAME=delivery_session
REFRESH_COOKIE_NAME=delivery_refresh
CSRF_COOKIE_NAME=delivery_csrf

# Storage publico. A chave anon e publica; a seguranca depende das policies versionadas.
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Somente durante o comando bootstrap:master. Remova logo depois.
MASTER_BOOTSTRAP_NAME=Admin Master
MASTER_BOOTSTRAP_DB_NAME=emanuelle-confeitaria
MASTER_BOOTSTRAP_EMAIL=master@example.com
MASTER_BOOTSTRAP_PASSWORD=replace-with-a-strong-one-time-password
