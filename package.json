  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server.ts \"server/**/*.ts\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"src/features/customer/**/*.ts\" src/lib/api.ts src/lib/supabase.ts src/components/AcceptInvitation.tsx src/components/AddressBookModal.tsx src/components/CartDrawer.tsx src/components/ChangePasswordModal.tsx src/components/CheckoutModal.tsx src/components/DeliveryAddressModal.tsx src/components/LoyaltyModal.tsx src/components/OrderTracking.tsx src/components/Orders.tsx src/components/PhoneAuthModal.tsx src/components/ProfileEditModal.tsx src/components/MasterDashboard.tsx \"src/components/master/**/*.ts\" \"src/components/master/**/*.tsx\" src/components/TenantAdminDashboard.tsx \"src/components/tenant-admin/**/*.ts\" \"src/components/tenant-admin/**/*.tsx\" src/components/landing/PlatformLanding.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:prod",
    "bootstrap:master": "tsx scripts/bootstrap/master-admin.ts",
    "bootstrap:master:mfa": "tsx scripts/bootstrap/rotate-master-mfa.ts",
    "migrate:tenant": "tsx scripts/migrations/001-initial-tenant.ts",
    "migrate:customer-orders": "tsx scripts/migrations/002-customer-order-links.ts"
  },
